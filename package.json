{
  "name": "kopli-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite\"",
    "build": "prisma generate && tsc -b && esbuild server/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=server/server-bundle.mjs && vite build",
    "start": "tsx server/index.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@tavily/core": "^1.1.0",
    "@vitejs/plugin-react": "latest",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "latest",
    "docx": "latest",
    "dotenv": "latest",
    "express": "latest",
    "express-rate-limit": "^8.7.5",
    "groq-sdk": "latest",
    "helmet": "^8.3.0",
    "lucide-react": "latest",
    "mammoth": "^1.13.0",
    "multer": "latest",
    "pdf-parse": "1.1.1",
    "pdfkit": "latest",
    "pptxgenjs": "4.0.0",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "latest",
    "remark-gfm": "latest",
    "tsx": "^4.23.15",
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "latest",
    "@types/express": "latest",
    "@types/multer": "latest",
    "@types/node": "latest",
    "@types/pdfkit": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "prisma": "^6.19.0",
    "tsx": "latest",
    "typescript": "5.9.3",
    "vite": "latest",
    "vitest": "latest",
    "esbuild": "0.28.2"
  }
}
