{
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/handler?__originalPath=/health"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/handler?__originalPath=/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "installCommand": "npm install --include=dev",
  "functions": {
    "api/handler.ts": {
      "includeFiles": "server/server-bundle.mjs"
    }
  }
}
